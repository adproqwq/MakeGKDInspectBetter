{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/adproqwq/MikuMagicWand/Miku/selectors.meta.schema.json",
  "title": "Selectors Meta File Schema",
  "description": "A JSON schema schema for MikuMagicWand selectors subscription meta file.",
  "properties": {
    "name": {
      "title": "订阅名",
      "description": "订阅的名称",
      "type": "string"
    },
    "id": {
      "title": "订阅的识别 id",
      "description": "订阅的唯一识别 id，相同的 id 将被视作同一订阅。同时也将作为使用时的外显名称。",
      "type": "string"
    },
    "description": {
      "title": "订阅描述",
      "description": "对于订阅的描述",
      "type": "string"
    },
    "author": {
      "title": "订阅作者",
      "description": "订阅的作者",
      "type": "string"
    },
    "selectors": {
      "title": "选择器文件链接",
      "description": "指向具体选择器文件的链接。仅支持绝对链接",
      "type": "string",
      "format": "uri"
    }
  },
  "required": ["name", "id", "selectors"]
}
